# ==========================================
# Flutter Web .htaccess (Production Safe)
# Prevent stale builds + safe caching strategy
# ==========================================

# ---------- MIME TYPES ----------
AddType text/javascript .js
AddType text/javascript .mjs
AddType application/wasm .wasm
AddType text/css .css
AddType text/html .html
AddType application/json .json

# ---------- COMPRESSION ----------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE \
        text/html \
        text/css \
        text/javascript \
        application/javascript \
        application/json \
        application/wasm
</IfModule>

# ---------- CACHE CONTROL ----------
<IfModule mod_headers.c>

    # Default: NEVER cache (Flutter app shell safety)
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"

    # Static assets: cache for a day (filenames are not hashed, so never "immutable").
    # .wasm is excluded on purpose: main.dart.wasm is the app itself and must stay "no-cache"
    <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|otf)$">
        Header always set Cache-Control "public, max-age=86400"
        Header always unset Pragma
        Header always unset Expires
    </FilesMatch>
</IfModule>